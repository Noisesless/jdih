APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_TIMEZONE=Asia/Jakarta
APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=jdih_banjarnegara
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ------------------------------------------------------------------
# AI Legal Assistant (Google Gemini & CFRouter)
# ------------------------------------------------------------------
# Gunakan Google Gemini resmi (Direkomendasikan)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Alternatif: CFRouter
CFROUTER_API_KEY=
CFROUTER_API_URL=https://api.cfrouter.my.id/v1
CFROUTER_EMBEDDING_MODEL=agnes-2.5-flash
CFROUTER_GENERATION_MODEL=deepseek-v4-pro-0813

# Opsional — parameter RAG (jumlah potongan dokumen & ukuran potongan)
RAG_MAX_CHUNKS=5
RAG_CHUNK_SIZE=500

# ------------------------------------------------------------------
# Sinkronisasi JDIHN (Jaringan Dokumentasi & Informasi Hukum Nasional)
# ------------------------------------------------------------------
# CATATAN: Konfigurasi JDIHN TIDAK dibaca dari file .env.
# Seluruh pengaturan (API URL, API token, org code, interval sync)
# dikelola lewat admin panel di: /admin/jdih-sync-settings
# dan tersimpan di tabel `jdih_api_settings` — token disimpan
# TERENKRIPSI (Crypt::encryptString) oleh model JdihApiSetting.
#
# Alternatif untuk setup awal lewat CLI (interaktif):
#   php artisan jdih:configure-api
#
# Nilai default API URL: https://jdihnh.kemkumham.go.id/api
